#!name=G1 ACQ Plus（被动 SKU 识别）
#!desc=采集 Google One 的 SKU，本机报告标记 2TB / Pro，原样放行响应。
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/BOLUOXIN/g1-acq-plus/main/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/BOLUOXIN/g1-acq-plus/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
